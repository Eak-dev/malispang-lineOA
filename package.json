{
  "name": "malispang-line-oa-phase-1a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "benchmark:mp-06": "node --import tsx scripts/run-mp-06-benchmark.ts generate",
    "benchmark:mp-06:check": "node --import tsx scripts/run-mp-06-benchmark.ts check",
    "ai-nlu:mp-06:check": "node --import tsx scripts/run-mp-06-ai-nlu-eval.ts check",
    "ai-nlu:mp-06:live": "node --import tsx scripts/run-mp-06-ai-nlu-eval.ts live",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm validate:toolchain && pnpm render:rich-menu && pnpm preview && pnpm preview:rich-menu && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:flex && pnpm validate:rich-menu && pnpm validate:approved-knowledge-base && pnpm validate:product-catalog && pnpm validate:draft-order-config && pnpm validate:production-readiness && pnpm validate:project-control && pnpm validate:mp-06-policy && pnpm validate:mp-06-test-readiness && pnpm benchmark:mp-06:check && pnpm ai-nlu:mp-06:check && pnpm worker:dry-run",
    "audit:dependencies": "pnpm audit --audit-level high",
    "deploy:test": "wrangler deploy --minify",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "preview": "node --import tsx scripts/generate-flex-preview.ts",
    "preview:rich-menu": "node --import tsx scripts/generate-rich-menu-preview.ts",
    "preinstall": "node scripts/validate-toolchain.mjs",
    "render:rich-menu": "node --import tsx scripts/render-rich-menu.ts",
    "secret:scan": "node --import tsx scripts/secret-scan.ts",
    "test": "pnpm test:node && pnpm test:worker",
    "test:node": "pnpm test:node:unit && pnpm test:node:benchmark",
    "test:node:benchmark": "vitest run tests/mp-06-wp2-benchmark.test.ts --config vitest.config.ts",
    "test:node:unit": "vitest run --config vitest.config.ts --exclude tests/mp-06-wp2-benchmark.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "validate:flex": "node --import tsx scripts/validate-flex.ts",
    "validate:approved-knowledge-base": "node --import tsx scripts/validate-approved-knowledge-base.ts",
    "validate:product-catalog": "node --import tsx scripts/validate-product-catalog.ts",
    "validate:draft-order-config": "node --import tsx scripts/validate-draft-order-config.ts",
    "validate:production-readiness": "node --import tsx scripts/validate-production-readiness.ts",
    "validate:project-control": "node --import tsx scripts/validate-project-control.mjs",
    "validate:mp-06-policy": "node --import tsx scripts/validate-mp-06-policy-snapshot.ts",
    "validate:mp-06-test-readiness": "node --import tsx scripts/validate-mp-06-test-readiness.ts",
    "validate:rich-menu": "node --import tsx scripts/validate-rich-menu.ts",
    "validate:toolchain": "node scripts/validate-toolchain.mjs",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "worker:types": "wrangler types worker-configuration.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "sharp": "0.35.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "4.1.11",
    "wrangler": "^4.122.0"
  }
}
