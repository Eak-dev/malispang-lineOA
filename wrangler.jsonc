{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "malispang-lineoa-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "TEST",
    "LINE_OA_ACCOUNT_NAME": "มะลิปัง TEST",
    "FAQ_SOURCE_STATUS": "TEST_SEED",
    "TEST_STAFF_ALLOWLIST": "OWNER_TEST",
    "PROCESSED_EVENT_RETENTION_SECONDS": "86400",
    "AUDIT_RETENTION_SECONDS": "604800",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_STATE",
        "class_name": "ConversationStateDO",
      },
      {
        "name": "HANDOFF_REGISTRY",
        "class_name": "HandoffRegistryDO",
      },
    ],
  },
  "exports": {
    "ConversationStateDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "HandoffRegistryDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
    },
  },
}
