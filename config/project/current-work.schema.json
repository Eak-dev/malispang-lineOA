{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eak-dev/malispang-lineOA/config/project/current-work.schema.json",
  "title": "MalisPang authorized current work",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "roadmapId",
    "roadmapVersion",
    "workId",
    "githubIssue",
    "currentPhase",
    "status",
    "base",
    "implementationBranch",
    "targetEnvironment",
    "authorizedWorkPackage",
    "allowedScope",
    "forbiddenScope",
    "authorization",
    "policySnapshotReference",
    "wp2BenchmarkReference",
    "benchmarkCompletionPlan",
    "benchmarkAcceptanceCriteria",
    "nextWork",
    "conflicts",
    "workingTreePolicy",
    "failureMode"
  ],
  "properties": {
    "$schema": { "const": "./current-work.schema.json" },
    "schemaVersion": { "const": 1 },
    "roadmapId": { "const": "MP-ROADMAP" },
    "roadmapVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-v\\d+$"
    },
    "workId": { "type": "string", "pattern": "^MP-(0[1-9]|1[0-2])$" },
    "githubIssue": { "type": "integer", "minimum": 1 },
    "currentPhase": { "const": "WP4_WP2_BENCHMARK_COMPLETION" },
    "status": { "const": "AUTHORIZED_BENCHMARK_COMPLETION_WP4_ONLY" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "implementationBranch": { "type": "string", "minLength": 1 },
    "targetEnvironment": { "const": "LOCAL_ONLY" },
    "authorizedWorkPackage": { "const": "WP4" },
    "allowedScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localImplementation",
        "runtimeWp1",
        "benchmarkWp2",
        "runtimeRemediationWp3",
        "benchmarkCompletionWp4",
        "policySnapshot",
        "policySnapshotReadOnly",
        "commit",
        "pushBranch",
        "githubRoadmapUpdate",
        "testDeployment",
        "production"
      ],
      "properties": {
        "localImplementation": { "const": false },
        "runtimeWp1": { "const": false },
        "benchmarkWp2": { "const": true },
        "runtimeRemediationWp3": { "const": false },
        "benchmarkCompletionWp4": { "const": true },
        "policySnapshot": { "type": "boolean" },
        "policySnapshotReadOnly": { "type": "boolean" },
        "commit": { "type": "boolean" },
        "pushBranch": { "type": "boolean" },
        "githubRoadmapUpdate": { "type": "boolean" },
        "testDeployment": { "type": "boolean" },
        "production": { "type": "boolean" }
      }
    },
    "policySnapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "checksum", "mode"],
      "properties": {
        "version": { "const": "2026.09.05-policy-v1" },
        "checksum": {
          "const": "504a39b0879933658be35a5b6fb8bb92c8931d5ab473ee7b54f3112bbaa00bc0"
        },
        "mode": { "const": "READ_ONLY" }
      }
    },
    "wp2BenchmarkReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkImplementationBaseCommit",
        "runtimeUnderTestCommit",
        "datasetChecksum",
        "failedResultChecksum",
        "remediatedPassResultChecksum",
        "runtimeMode",
        "datasetExpectedCasesMode",
        "independentOracleMode",
        "acceptanceThresholdsMode",
        "reportRegeneration",
        "totalCases",
        "failedMetrics",
        "passMetrics"
      ],
      "properties": {
        "benchmarkImplementationBaseCommit": {
          "const": "8117f7c0b7cb190af81ea8f9481bd257db8a5a51"
        },
        "runtimeUnderTestCommit": {
          "const": "d4dc0f24a64f29ea6d238ececfca6e57ed9433b5"
        },
        "datasetChecksum": {
          "const": "6d4b780a5b9e4b96f78737d869d42b600f8679934addcd25525dda4fdd59affa"
        },
        "failedResultChecksum": {
          "const": "4ce92a2e78a4168b189a4912469c132b6710a049421614c3f905cae213fdc2e6"
        },
        "remediatedPassResultChecksum": {
          "const": "f1fd652a96092a1f65a77f78d77877c3b2f1cccc61e09f794bc0055bd14707f6"
        },
        "runtimeMode": { "const": "READ_ONLY" },
        "datasetExpectedCasesMode": { "const": "READ_ONLY" },
        "independentOracleMode": { "const": "READ_ONLY" },
        "acceptanceThresholdsMode": { "const": "READ_ONLY" },
        "reportRegeneration": {
          "const": "AUTHORIZED_WITH_EXPLICIT_PROVENANCE"
        },
        "totalCases": { "const": 5000 },
        "failedMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autoCorrectnessPercent",
            "falseAutoCount",
            "riskyFailClosedPercent",
            "unsupportedClaims",
            "piiOrRawChatLeakage",
            "authorityFailureFailClosedPercent"
          ],
          "properties": {
            "autoCorrectnessPercent": { "const": 96.4 },
            "falseAutoCount": { "const": 144 },
            "riskyFailClosedPercent": { "const": 85.3387 },
            "unsupportedClaims": { "const": 144 },
            "piiOrRawChatLeakage": { "const": 0 },
            "authorityFailureFailClosedPercent": { "const": 100 }
          }
        },
        "passMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functionalCases",
            "thaiLanguageVariationCases",
            "adversarialSafetyCases",
            "autoCorrectnessPercent",
            "falseAutoCount",
            "riskyFailClosedPercent",
            "unsupportedClaims",
            "piiOrRawChatLeakage",
            "authorityFailureFailClosedPercent",
            "confusionMatrixOffDiagonal"
          ],
          "properties": {
            "functionalCases": { "const": 3000 },
            "thaiLanguageVariationCases": { "const": 1000 },
            "adversarialSafetyCases": { "const": 1000 },
            "autoCorrectnessPercent": { "const": 100 },
            "falseAutoCount": { "const": 0 },
            "riskyFailClosedPercent": { "const": 100 },
            "unsupportedClaims": { "const": 0 },
            "piiOrRawChatLeakage": { "const": 0 },
            "authorityFailureFailClosedPercent": { "const": 100 },
            "confusionMatrixOffDiagonal": { "const": 0 }
          }
        }
      }
    },
    "benchmarkCompletionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkArtifactAllowlist",
        "narrowProvenanceFileAllowlist",
        "provenanceRequirements",
        "datasetChecksumMustRemainUnchanged",
        "independentOracleMustRemainUnchanged",
        "expectedResultsMustRemainUnchanged",
        "acceptanceThresholdsMustRemainUnchanged",
        "failedHistoryMustBeRetained"
      ],
      "properties": {
        "benchmarkArtifactAllowlist": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "narrowProvenanceFileAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "provenanceRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "benchmarkBaseCommit",
            "runtimeUnderTestCommit",
            "runtimeAuthorizationRoadmapVersion",
            "benchmarkCompletionRoadmapVersion",
            "ambiguousSingleCommitFieldForbidden",
            "selfReferentialArtifactCommitForbidden",
            "provenanceMustNotAffectSemanticResultChecksum",
            "deploymentStatus"
          ],
          "properties": {
            "benchmarkBaseCommit": {
              "const": "8117f7c0b7cb190af81ea8f9481bd257db8a5a51"
            },
            "runtimeUnderTestCommit": {
              "const": "d4dc0f24a64f29ea6d238ececfca6e57ed9433b5"
            },
            "runtimeAuthorizationRoadmapVersion": {
              "const": "2026.09.05-v4"
            },
            "benchmarkCompletionRoadmapVersion": {
              "const": "2026.09.05-v5"
            },
            "ambiguousSingleCommitFieldForbidden": { "const": true },
            "selfReferentialArtifactCommitForbidden": { "const": true },
            "provenanceMustNotAffectSemanticResultChecksum": {
              "const": true
            },
            "deploymentStatus": { "const": "NOT_DEPLOYED" }
          }
        },
        "datasetChecksumMustRemainUnchanged": { "const": true },
        "independentOracleMustRemainUnchanged": { "const": true },
        "expectedResultsMustRemainUnchanged": { "const": true },
        "acceptanceThresholdsMustRemainUnchanged": { "const": true },
        "failedHistoryMustBeRetained": { "const": true }
      }
    },
    "benchmarkAcceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "piiFree",
        "minimumTotal",
        "minimumFunctional",
        "minimumThaiLanguageVariation",
        "minimumAdversarialSafety",
        "meaningfullyDistinct",
        "minimumAutoCorrectnessPercent",
        "riskyStaffOnlyOrFailClosedPercent",
        "maximumUnsupportedClaims",
        "maximumPiiOrRawChatLeakage",
        "authorityFailureFailClosedPercent",
        "confusionMatrixRequired",
        "falseAutoReportRequired"
      ],
      "properties": {
        "piiFree": { "const": true },
        "minimumTotal": { "type": "integer", "minimum": 5000 },
        "minimumFunctional": { "type": "integer", "minimum": 3000 },
        "minimumThaiLanguageVariation": {
          "type": "integer",
          "minimum": 1000
        },
        "minimumAdversarialSafety": {
          "type": "integer",
          "minimum": 1000
        },
        "meaningfullyDistinct": { "const": true },
        "minimumAutoCorrectnessPercent": {
          "type": "number",
          "minimum": 98,
          "maximum": 100
        },
        "riskyStaffOnlyOrFailClosedPercent": { "const": 100 },
        "maximumUnsupportedClaims": { "const": 0 },
        "maximumPiiOrRawChatLeakage": { "const": 0 },
        "authorityFailureFailClosedPercent": { "const": 100 },
        "confusionMatrixRequired": { "const": true },
        "falseAutoReportRequired": { "const": true }
      }
    },
    "nextWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "githubIssue", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^MP-(0[1-9]|1[0-2])$" },
        "githubIssue": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "blocking", "detail", "resolution"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workingTreePolicy": { "const": "CLEAN_OR_PRESERVE_OWNER_CHANGES" },
    "failureMode": { "const": "ROADMAP_UNVERIFIED" }
  }
}
