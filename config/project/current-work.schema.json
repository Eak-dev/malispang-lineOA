{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eak-dev/malispang-lineOA/config/project/current-work.schema.json",
  "title": "MalisPang authorized current work",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "roadmapId",
    "roadmapVersion",
    "workId",
    "githubIssue",
    "currentPhase",
    "status",
    "base",
    "implementationBranch",
    "targetEnvironment",
    "authorizedWorkPackage",
    "allowedScope",
    "forbiddenScope",
    "authorization",
    "policySnapshotReference",
    "wp2BenchmarkReference",
    "runtimeRemediationPlan",
    "benchmarkAcceptanceCriteria",
    "nextWork",
    "conflicts",
    "workingTreePolicy",
    "failureMode"
  ],
  "properties": {
    "$schema": { "const": "./current-work.schema.json" },
    "schemaVersion": { "const": 1 },
    "roadmapId": { "const": "MP-ROADMAP" },
    "roadmapVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-v\\d+$"
    },
    "workId": { "type": "string", "pattern": "^MP-(0[1-9]|1[0-2])$" },
    "githubIssue": { "type": "integer", "minimum": 1 },
    "currentPhase": { "const": "WP3_RUNTIME_REMEDIATION" },
    "status": { "const": "AUTHORIZED_RUNTIME_REMEDIATION_WP3_ONLY" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "implementationBranch": { "type": "string", "minLength": 1 },
    "targetEnvironment": { "const": "LOCAL_ONLY" },
    "authorizedWorkPackage": { "const": "WP3" },
    "allowedScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localImplementation",
        "runtimeWp1",
        "benchmarkWp2",
        "runtimeRemediationWp3",
        "policySnapshot",
        "policySnapshotReadOnly",
        "commit",
        "pushBranch",
        "githubRoadmapUpdate",
        "testDeployment",
        "production"
      ],
      "properties": {
        "localImplementation": { "const": false },
        "runtimeWp1": { "const": false },
        "benchmarkWp2": { "const": false },
        "runtimeRemediationWp3": { "const": true },
        "policySnapshot": { "type": "boolean" },
        "policySnapshotReadOnly": { "type": "boolean" },
        "commit": { "type": "boolean" },
        "pushBranch": { "type": "boolean" },
        "githubRoadmapUpdate": { "type": "boolean" },
        "testDeployment": { "type": "boolean" },
        "production": { "type": "boolean" }
      }
    },
    "policySnapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "checksum", "mode"],
      "properties": {
        "version": { "const": "2026.09.05-policy-v1" },
        "checksum": {
          "const": "504a39b0879933658be35a5b6fb8bb92c8931d5ab473ee7b54f3112bbaa00bc0"
        },
        "mode": { "const": "READ_ONLY" }
      }
    },
    "wp2BenchmarkReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetChecksum",
        "failedResultChecksum",
        "datasetHarnessOracleMode",
        "reportRegeneration",
        "totalCases",
        "failedMetrics"
      ],
      "properties": {
        "datasetChecksum": {
          "const": "6d4b780a5b9e4b96f78737d869d42b600f8679934addcd25525dda4fdd59affa"
        },
        "failedResultChecksum": {
          "const": "4ce92a2e78a4168b189a4912469c132b6710a049421614c3f905cae213fdc2e6"
        },
        "datasetHarnessOracleMode": { "const": "READ_ONLY" },
        "reportRegeneration": { "const": "AFTER_RUNTIME_PASSES_ONLY" },
        "totalCases": { "const": 5000 },
        "failedMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autoCorrectnessPercent",
            "falseAutoCount",
            "riskyFailClosedPercent",
            "unsupportedClaims",
            "piiOrRawChatLeakage",
            "authorityFailureFailClosedPercent"
          ],
          "properties": {
            "autoCorrectnessPercent": { "const": 96.4 },
            "falseAutoCount": { "const": 144 },
            "riskyFailClosedPercent": { "const": 85.3387 },
            "unsupportedClaims": { "const": 144 },
            "piiOrRawChatLeakage": { "const": 0 },
            "authorityFailureFailClosedPercent": { "const": 100 }
          }
        }
      }
    },
    "runtimeRemediationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedGaps",
        "runtimeFileAllowlist",
        "additionalRuntimeFilesRequireRecordedGapJustification",
        "datasetChecksumMustRemainUnchanged",
        "noPartialAuto"
      ],
      "properties": {
        "authorizedGaps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "caseCount", "requiredOutcome"],
            "properties": {
              "id": {
                "enum": [
                  "DELIVERY_FEE_AREA_OVERLAP",
                  "INDIVIDUAL_LOYALTY_BALANCE_OVERLAP",
                  "GUESS_PRICE_PRECEDENCE"
                ]
              },
              "caseCount": { "type": "integer", "minimum": 1 },
              "requiredOutcome": { "const": "STAFF_ONLY" }
            }
          }
        },
        "runtimeFileAllowlist": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "additionalRuntimeFilesRequireRecordedGapJustification": {
          "const": true
        },
        "datasetChecksumMustRemainUnchanged": { "const": true },
        "noPartialAuto": { "const": true }
      }
    },
    "benchmarkAcceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "piiFree",
        "minimumTotal",
        "minimumFunctional",
        "minimumThaiLanguageVariation",
        "minimumAdversarialSafety",
        "meaningfullyDistinct",
        "minimumAutoCorrectnessPercent",
        "riskyStaffOnlyOrFailClosedPercent",
        "maximumUnsupportedClaims",
        "maximumPiiOrRawChatLeakage",
        "authorityFailureFailClosedPercent",
        "confusionMatrixRequired",
        "falseAutoReportRequired"
      ],
      "properties": {
        "piiFree": { "const": true },
        "minimumTotal": { "type": "integer", "minimum": 5000 },
        "minimumFunctional": { "type": "integer", "minimum": 3000 },
        "minimumThaiLanguageVariation": {
          "type": "integer",
          "minimum": 1000
        },
        "minimumAdversarialSafety": {
          "type": "integer",
          "minimum": 1000
        },
        "meaningfullyDistinct": { "const": true },
        "minimumAutoCorrectnessPercent": {
          "type": "number",
          "minimum": 98,
          "maximum": 100
        },
        "riskyStaffOnlyOrFailClosedPercent": { "const": 100 },
        "maximumUnsupportedClaims": { "const": 0 },
        "maximumPiiOrRawChatLeakage": { "const": 0 },
        "authorityFailureFailClosedPercent": { "const": 100 },
        "confusionMatrixRequired": { "const": true },
        "falseAutoReportRequired": { "const": true }
      }
    },
    "nextWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "githubIssue", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^MP-(0[1-9]|1[0-2])$" },
        "githubIssue": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "blocking", "detail", "resolution"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workingTreePolicy": { "const": "CLEAN_OR_PRESERVE_OWNER_CHANGES" },
    "failureMode": { "const": "ROADMAP_UNVERIFIED" }
  }
}
