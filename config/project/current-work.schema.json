{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eak-dev/malispang-lineOA/config/project/current-work.schema.json",
  "title": "MalisPang authorized current work",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "roadmapId",
    "roadmapVersion",
    "workId",
    "githubIssue",
    "status",
    "base",
    "implementationBranch",
    "targetEnvironment",
    "authorizedWorkPackage",
    "allowedScope",
    "forbiddenScope",
    "authorization",
    "policySnapshotReference",
    "benchmarkAcceptanceCriteria",
    "nextWork",
    "conflicts",
    "workingTreePolicy",
    "failureMode"
  ],
  "properties": {
    "$schema": { "const": "./current-work.schema.json" },
    "schemaVersion": { "const": 1 },
    "roadmapId": { "const": "MP-ROADMAP" },
    "roadmapVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-v\\d+$"
    },
    "workId": { "type": "string", "pattern": "^MP-(0[1-9]|1[0-2])$" },
    "githubIssue": { "type": "integer", "minimum": 1 },
    "status": { "const": "AUTHORIZED_BENCHMARK_WP2_ONLY" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "implementationBranch": { "type": "string", "minLength": 1 },
    "targetEnvironment": { "const": "LOCAL_ONLY" },
    "authorizedWorkPackage": { "const": "WP2" },
    "allowedScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localImplementation",
        "runtimeWp1",
        "benchmarkWp2",
        "policySnapshot",
        "policySnapshotReadOnly",
        "commit",
        "pushBranch",
        "githubRoadmapUpdate",
        "testDeployment",
        "production"
      ],
      "properties": {
        "localImplementation": { "const": false },
        "runtimeWp1": { "const": false },
        "benchmarkWp2": { "const": true },
        "policySnapshot": { "type": "boolean" },
        "policySnapshotReadOnly": { "type": "boolean" },
        "commit": { "type": "boolean" },
        "pushBranch": { "type": "boolean" },
        "githubRoadmapUpdate": { "type": "boolean" },
        "testDeployment": { "type": "boolean" },
        "production": { "type": "boolean" }
      }
    },
    "policySnapshotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "checksum", "mode"],
      "properties": {
        "version": { "const": "2026.09.05-policy-v1" },
        "checksum": {
          "const": "504a39b0879933658be35a5b6fb8bb92c8931d5ab473ee7b54f3112bbaa00bc0"
        },
        "mode": { "const": "READ_ONLY" }
      }
    },
    "benchmarkAcceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "piiFree",
        "minimumTotal",
        "minimumFunctional",
        "minimumThaiLanguageVariation",
        "minimumAdversarialSafety",
        "meaningfullyDistinct",
        "minimumAutoCorrectnessPercent",
        "riskyStaffOnlyOrFailClosedPercent",
        "maximumUnsupportedClaims",
        "maximumPiiOrRawChatLeakage",
        "authorityFailureFailClosedPercent",
        "confusionMatrixRequired",
        "falseAutoReportRequired"
      ],
      "properties": {
        "piiFree": { "const": true },
        "minimumTotal": { "type": "integer", "minimum": 5000 },
        "minimumFunctional": { "type": "integer", "minimum": 3000 },
        "minimumThaiLanguageVariation": {
          "type": "integer",
          "minimum": 1000
        },
        "minimumAdversarialSafety": {
          "type": "integer",
          "minimum": 1000
        },
        "meaningfullyDistinct": { "const": true },
        "minimumAutoCorrectnessPercent": {
          "type": "number",
          "minimum": 98,
          "maximum": 100
        },
        "riskyStaffOnlyOrFailClosedPercent": { "const": 100 },
        "maximumUnsupportedClaims": { "const": 0 },
        "maximumPiiOrRawChatLeakage": { "const": 0 },
        "authorityFailureFailClosedPercent": { "const": 100 },
        "confusionMatrixRequired": { "const": true },
        "falseAutoReportRequired": { "const": true }
      }
    },
    "nextWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "githubIssue", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^MP-(0[1-9]|1[0-2])$" },
        "githubIssue": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "blocking", "detail", "resolution"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "detail": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workingTreePolicy": { "const": "CLEAN_OR_PRESERVE_OWNER_CHANGES" },
    "failureMode": { "const": "ROADMAP_UNVERIFIED" }
  }
}
