+const controls = [
+  "config/project/roadmap.json",
+  "config/project/current-work.json",
+  "config/project/current-work.schema.json",
+] as const;
+const read = (path: string) =>
+  JSON.parse(readFileSync(new URL(path, root), "utf8")) as Record<
+    string,
+    unknown
+  >;
